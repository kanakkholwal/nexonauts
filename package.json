{
	"name": "nexonauts",
	"version": "0.5.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build --mode production",
		"deploy:cloudflare": "wrangler deploy",
		"preview": "vite preview",
		"start": "node build/index.js",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "biome check --write .",
		"lint": "biome check .",
		"check:dashes": "node scripts/check-dashes.mjs",
		"check:comments": "node scripts/check-comments.mjs --all",
		"check:contrast": "node scripts/check-contrast.mjs",
		"gate": "node scripts/check-dashes.mjs && node scripts/check-comments.mjs --all && node scripts/check-contrast.mjs && biome check . && bun run check"
	},
	"dependencies": {
		"@better-fetch/fetch": "^1.3.1",
		"@docvia/renderer-svelte": "^0.2.4",
		"@docvia/source": "^0.4.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/source-code-pro": "^5.2.7",
		"@tabler/icons-svelte": "^3.46.0",
		"@tailwindcss/typography": "^0.5.20",
		"bcryptjs": "^3.0.3",
		"better-auth": "^1.7.1",
		"bits-ui": "^2.19.0",
		"cloudinary": "^2.10.1",
		"clsx": "^2.1.1",
		"cssbeautify": "^0.3.1",
		"embla-carousel-autoplay": "^8.6.0",
		"embla-carousel-svelte": "^8.6.0",
		"formsnap": "^2.0.1",
		"gsap": "^3.15.0",
		"jsonwebtoken": "^9.0.3",
		"jszip": "^3.10.1",
		"mongoose": "^9.9.3",
		"motion": "^13.1.1",
		"nanoid": "^6.0.1",
		"node-html-parser": "^9.0.1",
		"nprogress": "^0.2.0",
		"pdf-lib": "^1.17.1",
		"pretty": "^2.0.0",
		"rehype-highlight": "^7.0.2",
		"rehype-raw": "^7.0.0",
		"remark-gfm": "^4.0.1",
		"sharp": "^0.35.3",
		"shiki": "^4.4.3",
		"svelte-sonner": "^1.2.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.6.0",
		"turndown": "^7.2.4",
		"tw-animate-css": "^1.4.0",
		"vaul-svelte": "^1.0.0-next.7",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@docvia/cli": "^1.0.0",
		"@docvia/plugin-shiki": "^0.2.2",
		"@docvia/plugin-vite": "^1.0.0",
		"@internationalized/date": "^3.12.3",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/aos": "^3.0.8",
		"@types/bcryptjs": "^3.0.0",
		"@types/cssbeautify": "^0.3.5",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/nprogress": "^0.2.3",
		"@types/pretty": "^2.0.3",
		"@types/prismjs": "^1.26.6",
		"@types/turndown": "^5.0.6",
		"cross-env": "^7.0.3",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.125.0"
	},
	"packageManager": "bun@1.2.0"
}
