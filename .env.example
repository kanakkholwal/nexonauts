# Mirrors src/lib/server/env.ts. If a name is not in that schema, it is not read.
# For local Cloudflare Worker development, put server values in `.dev.vars`
# rather than committing them.

# ─── Public (browser-exposed) ──────────────────────────────
# SvelteKit only exposes vars prefixed with PUBLIC_ to the client.
PUBLIC_BASE_URL="http://localhost:3000"

# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
BASE_URL=http://localhost:3000

# Auth (better-auth). The four provider values are required by the schema.
BETTER_AUTH_SECRET=BETTER_AUTH_SECRET
GOOGLE_ID=GOOGLE_ID
GOOGLE_SECRET=GOOGLE_SECRET
INTEGRATION_GITHUB_ID=GITHUB_ID
INTEGRATION_GITHUB_SECRET=GITHUB_SECRET
JWT_SECRET=JWT_SECRET

# Database
MONGODB_URI=MONGODB_URI

# Mailer
BASE_MAIL_SERVER_URL=mailer.example.com
SERVER_IDENTITY=SERVER_IDENTITY
